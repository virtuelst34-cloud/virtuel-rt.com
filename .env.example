# Variables d'environnement pour Virtuel-RT
# Copiez ce fichier en .env.local et remplissez les valeurs

# Supabase (requis)
# https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Sentry (optionnel — monitoring d'erreurs)
# VITE_SENTRY_DSN=https://votre-dsn@sentry.io/project

# WebRTC STUN (défaut Google — TURN recommandé en NAT strict)
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# Pour npm run supabase:migrate (mot de passe BDD — ne jamais committer)
# DATABASE_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres

# FTP Hostinger — pour CI GitHub Actions (scripts/set-github-secrets.ps1)
# hPanel > Fichiers > Comptes FTP
FTP_SERVER=ftp.virtuel-rt.com
FTP_USERNAME=u109062338
FTP_PASSWORD=
FTP_SERVER_DIR=/domains/virtuel-rt.com/public_html/

# ── Alertes modération (Edge Function moderation-alerts) ──
# Configurer comme secrets Supabase : Dashboard → Edge Functions → Secrets
# (ou `supabase secrets set KEY=value`)
#
# Email via Resend (https://resend.com) :
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=alerts@virtuel-rt.com
#
# SMS via Twilio (https://www.twilio.com) :
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+33xxxxxxxxx
#
# Sans ces secrets, les alertes email/SMS restent en file (status provider_missing)
# visibles dans Admin → Centre de modération → Canaux / File.

# Secrets GitHub Actions (CI deploy Hostinger) :
# - FTP_SERVER, FTP_USERNAME, FTP_PASSWORD
# - FTP_SERVER_DIR (optionnel, défaut /domains/virtuel-rt.com/public_html/)
# - VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SENTRY_DSN
